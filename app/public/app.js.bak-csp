const $=s=>document.querySelector(s), fmt=n=>Number(n).toLocaleString('vi-VN')+' ₫', esc=s=>String(s??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
let page='dashboard',menu=[],tables=[],orders=[],categories=[],selected=[];
async function api(url,method='GET',body){const r=await fetch('/api'+url,{method,headers:{'Content-Type':'application/json'},credentials:'same-origin',body:body===undefined?undefined:JSON.stringify(body)});let j=await r.json().catch(()=>({}));if(r.status===401){$('#shell').classList.add('hidden');$('#login').classList.remove('hidden');throw Error('Phiên đăng nhập hết hạn')}if(!r.ok)throw Error(j.error||'Yêu cầu thất bại');return j}
function toast(msg){const n=$('#toast');n.textContent=msg;n.classList.add('show');setTimeout(()=>n.classList.remove('show'),3500)}
async function run(fn){try{await fn()}catch(e){toast(e.message)}}
const pill=s=>`<span class="pill ${s}">${{open:'Đang phục vụ',paid:'Đã thanh toán',cancelled:'Đã hủy',available:'Còn trống',occupied:'Đang dùng'}[s]||esc(s)}</span>`;
async function load(){const u=await api('/me');$('#who').textContent=u.email;$('#login').classList.add('hidden');$('#shell').classList.remove('hidden');await navigate(page)}
async function navigate(p){page=p;$('#nav').querySelectorAll('button').forEach(b=>b.classList.toggle('active',b.dataset.page===p));$('#pageTitle').textContent=({dashboard:'Tổng quan',tables:'Quản lý bàn ăn',menu:'Quản lý thực đơn',orders:'Quản lý đơn hàng'})[p];await ({dashboard:dashboard,tables:showTables,menu:showMenu,orders:showOrders})[p]()}
async function dashboard(){const d=await api('/dashboard');$('#main').innerHTML=`<div class="stats">${[['Tổng số bàn',d.tables,'Bàn đang quản lý'],['Món đang bán',d.menu,'Món trong thực đơn'],['Đơn đang mở',d.open,'Đơn cần xử lý'],['Doanh thu hôm nay',fmt(d.sales),'Từ đơn đã thanh toán']].map(([k,v,a])=>`<div class="stat"><div class="k">${k}</div><div class="v">${v}</div><div class="detail">${a}</div></div>`).join('')}</div><div class="section-head"><h3>Đơn hàng gần đây</h3><button class="btn" data-go="orders">Xem tất cả →</button></div><div class="panel">${orderTable(d.recent)}</div>`}
function orderTable(list){return list.length?`<table class="table"><thead><tr><th>Mã đơn</th><th>Bàn</th><th>Ngày giờ</th><th>Giá trị</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>${list.map(o=>`<tr><td><b>#${o.id}</b></td><td>${esc(o.table_name)}</td><td>${new Date(o.created_at).toLocaleString('vi-VN')}</td><td>${fmt(o.total)}</td><td>${pill(o.status)}</td><td>${o.status==='open'?`<div class="action-bar"><button class="btn" data-pay="${o.id}">Thanh toán</button><button class="btn danger" data-cancel="${o.id}">Hủy</button></div>`:'—'}</td></tr>`).join('')}</tbody></table>`:'<div class="empty">Chưa có đơn hàng nào</div>'}
async function showTables(){tables=await api('/tables');$('#main').innerHTML=`<div class="section-head"><div><h3>Sơ đồ bàn ăn</h3><div class="muted">Chọn bàn trống để lập đơn mới</div></div></div><div class="cards">${tables.map(t=>`<div class="table-card ${t.status}" data-table="${t.id}"><strong>▤ ${esc(t.name)}</strong><div class="sub">${t.seats} chỗ ngồi</div><div class="footer">${pill(t.status)} ${t.open_order_id?' · Đơn #'+t.open_order_id:''}</div></div>`).join('')}</div><div class="section-head"><h3>Thêm bàn mới</h3></div><div class="panel"><form id="tableForm" class="formrow"><label>Tên bàn<input class="form-control" name="name" maxlength="70" placeholder="Bàn 13" required></label><label>Số chỗ<input class="form-control" name="seats" type="number" value="4" min="1" max="100" required></label><button class="primary" type="submit" style="align-self:end">+ Thêm bàn</button></form></div>`}
async function showMenu(){[menu,categories]=await Promise.all([api('/menu'),api('/categories')]);$('#main').innerHTML=`<div class="section-head"><h3>Danh sách món ăn</h3><span class="muted">${menu.length} món</span></div><div class="panel"><table class="table"><thead><tr><th>Món ăn</th><th>Danh mục</th><th>Giá bán</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>${menu.map(m=>`<tr><td><b>${esc(m.name)}</b></td><td>${esc(m.category)}</td><td>${fmt(m.price)}</td><td>${m.available?pill('available'):'Ngừng bán'}</td><td><div class="action-bar"><button class="btn" data-edit="${m.id}">Sửa giá</button><button class="btn" data-toggle="${m.id}">${m.available?'Ngừng bán':'Bán lại'}</button><button class="btn danger" data-delete="${m.id}">Xóa</button></div></td></tr>`).join('')}</tbody></table></div><div class="section-head"><h3>Thêm món mới</h3></div><div class="panel"><form id="menuForm" class="formrow"><label>Tên món<input name="name" class="form-control" maxlength="120" required placeholder="Ví dụ: Gà nướng"></label><label>Giá bán (VND)<input name="price" class="form-control" type="number" min="0" step="1000" required></label><label>Danh mục<select name="category_id" class="form-control">${categories.map(c=>`<option value="${c.id}">${esc(c.name)}</option>`).join('')}</select></label><button class="primary" type="submit">+ Thêm món</button></form></div>`}
async function showOrders(){orders=await api('/orders');$('#main').innerHTML=`<div class="section-head"><h3>Danh sách đơn hàng</h3><button class="primary" id="newOrder">+ Tạo đơn mới</button></div><div class="panel">${orderTable(orders)}</div><div class="section-head"><h3>Chi tiết món đã gọi</h3></div><div class="panel">${orders.slice(0,15).map(o=>`<div class="line"><span><b>#${o.id}</b> · ${esc(o.table_name)}<br><span class="muted">${o.items.map(i=>`${esc(i.name)} × ${i.quantity}`).join(' · ')}</span></span><b>${fmt(o.total)}</b></div>`).join('')||'<div class="empty">Chưa có dữ liệu</div>'}</div>`}
async function newOrder(tableId){[tables,menu]=await Promise.all([api('/tables'),api('/menu')]);const available=tables.filter(t=>t.status==='available');if(!available.length){toast('Không còn bàn trống');return}if(tableId&&!available.some(t=>t.id===tableId)){toast('Bàn đã có đơn, vui lòng thanh toán trước');return}selected=[];$('#pageTitle').textContent='Tạo đơn hàng';$('#main').innerHTML=`<div class="section-head"><h3>Gọi món cho khách</h3><button class="btn" id="backOrders">← Quay lại</button></div><div class="order-grid"><div class="panel"><label class="muted">Chọn bàn</label><select class="form-control" id="orderTable">${available.map(t=>`<option value="${t.id}" ${t.id===tableId?'selected':''}>${esc(t.name)} — ${t.seats} chỗ</option>`).join('')}</select><div class="section-head"><h3>Thực đơn</h3></div>${menu.filter(m=>m.available).map(m=>`<div class="line"><span><b>${esc(m.name)}</b><br><span class="muted">${fmt(m.price)}</span></span><button class="btn" data-add="${m.id}">+ Thêm</button></div>`).join('')}</div><div class="panel"><div class="section-head"><h3>Đơn đang tạo</h3></div><div id="cart"></div><div id="cartTotal" class="total"></div><button class="primary" id="submitOrder" style="width:100%">Xác nhận tạo đơn</button></div></div>`;renderCart()}
function renderCart(){const el=$('#cart');if(!el)return;el.innerHTML=selected.length?selected.map(({id,quantity})=>{const m=menu.find(x=>x.id===id);return `<div class="line"><span>${esc(m.name)}<br><span class="muted">${fmt(m.price)}</span></span><div class="action-bar"><button class="btn" data-minus="${id}">−</button><b>${quantity}</b><button class="btn" data-add="${id}">+</button></div></div>`}).join(''):'<div class="empty">Chọn món ở bên trái</div>';$('#cartTotal').textContent='Tổng cộng: '+fmt(selected.reduce((sum,i)=>sum+menu.find(m=>m.id===i.id).price*i.quantity,0))}
$('#loginForm').addEventListener('submit',e=>{e.preventDefault();run(async()=>{try{await api('/login','POST',{email:$('#email').value,password:$('#password').value});$('#loginError').textContent='';await load()}catch(err){$('#loginError').textContent=err.message}})});
$('#logout').addEventListener('click',()=>run(async()=>{await api('/logout','POST');$('#shell').classList.add('hidden');$('#login').classList.remove('hidden')}));
$('#nav').addEventListener('click',e=>{const b=e.target.closest('[data-page]');if(b)run(()=>navigate(b.dataset.page))});
$('#main').addEventListener('submit',e=>{if(e.target.id==='tableForm'){e.preventDefault();const f=new FormData(e.target);run(async()=>{await api('/tables','POST',{name:f.get('name'),seats:Number(f.get('seats'))});toast('Đã thêm bàn');await showTables()})}if(e.target.id==='menuForm'){e.preventDefault();const f=new FormData(e.target);run(async()=>{await api('/menu','POST',{name:f.get('name'),price:Number(f.get('price')),category_id:Number(f.get('category_id'))});toast('Đã thêm món');await showMenu()})}});
$('#main').addEventListener('click',e=>{const b=e.target.closest('button,[data-table]');if(!b)return;run(async()=>{if(b.dataset.go)return navigate(b.dataset.go);if(b.dataset.table)return b.classList.contains('occupied')?navigate('orders'):newOrder(Number(b.dataset.table));if(b.id==='newOrder')return newOrder();if(b.id==='backOrders')return navigate('orders');if(b.dataset.edit){const m=menu.find(x=>x.id===Number(b.dataset.edit));const n=prompt('Giá mới cho '+m.name+' (VND)',m.price);if(n===null)return;await api('/menu/'+m.id,'PATCH',{price:Number(n)});toast('Đã cập nhật giá');return showMenu()}if(b.dataset.toggle){const m=menu.find(x=>x.id===Number(b.dataset.toggle));await api('/menu/'+m.id,'PATCH',{available:!m.available});return showMenu()}if(b.dataset.delete){if(!confirm('Bạn chắc chắn muốn xóa món này?'))return;await api('/menu/'+b.dataset.delete,'DELETE');return showMenu()}if(b.dataset.add){let id=Number(b.dataset.add),i=selected.find(x=>x.id===id);if(i){if(i.quantity<100)i.quantity++}else selected.push({id,quantity:1});return renderCart()}if(b.dataset.minus){let i=selected.find(x=>x.id===Number(b.dataset.minus));if(i){i.quantity--;selected=selected.filter(x=>x.quantity>0)}return renderCart()}if(b.id==='submitOrder'){if(!selected.length)return toast('Hãy chọn ít nhất một món');const result=await api('/orders','POST',{table_id:Number($('#orderTable').value),items:selected.map(i=>({menu_item_id:i.id,quantity:i.quantity}))});toast('Đã tạo đơn #'+result.id);return navigate('orders')}if(b.dataset.pay){if(!confirm('Xác nhận thanh toán đơn #'+b.dataset.pay+'?'))return;await api('/orders/'+b.dataset.pay+'/pay','POST');toast('Thanh toán thành công');return navigate(page)}if(b.dataset.cancel){if(!confirm('Hủy đơn #'+b.dataset.cancel+'?'))return;await api('/orders/'+b.dataset.cancel+'/cancel','POST');toast('Đã hủy đơn');return navigate(page)}})});
$('#today').textContent=new Date().toLocaleDateString('vi-VN',{weekday:'long',day:'2-digit',month:'long',year:'numeric'});
load().catch(()=>{});
