:root{font-family:Inter,system-ui,-apple-system,'Segoe UI',sans-serif;color:#1c3028;background:#f5f7f3}*{box-sizing:border-box}body{margin:0}button,input,select{font:inherit}button{cursor:pointer;border:0}button:disabled{opacity:.5;cursor:not-allowed}.hidden{display:none!important}.login-shell{min-height:100vh;display:grid;place-items:center;background:radial-gradient(circle at 75% 20%,#d7ede2,transparent 42%),#edf4ee}.login-card{width:min(420px,92vw);padding:40px;border-radius:22px;background:#fff;box-shadow:0 24px 70px #24462d20}.brand-mark{background:#1c654a;color:white;width:48px;height:48px;display:grid;place-items:center;border-radius:15px;font-size:27px}.login-card h1{font-size:32px;letter-spacing:-1px;margin:18px 0 0}.login-card p{color:#738178;margin-bottom:32px}.login-card label{display:block;font-weight:600;font-size:13px;margin:20px 0}.login-card input,.form-control{width:100%;display:block;border:1px solid #dde5db;border-radius:10px;padding:12px;margin-top:8px;background:white;color:#233c30}.login-card button{width:100%;margin-top:8px}.primary{background:#156044;color:#fff;border-radius:10px;padding:12px 18px;font-weight:700}.primary:hover{background:#0c5036}.error{color:#bc4040;margin-top:14px;min-height:15px;font-size:13px}.shell{min-height:100vh;display:flex}.sidebar{background:#163d30;color:#fff;width:245px;flex-shrink:0;display:flex;flex-direction:column;min-height:100vh;padding:29px 18px;position:sticky;top:0;height:100vh}.brand{font-size:22px;display:flex;align-items:center;gap:8px;padding:4px 12px 30px;flex-wrap:wrap}.brand small{display:block;color:#91bcaa;font-size:9px;letter-spacing:2px;width:100%;padding-left:28px}.nav{display:grid;gap:7px}.nav button{width:100%;border-radius:10px;padding:14px;text-align:left;background:transparent;color:#b4cec0;font-size:15px;display:flex;gap:12px;align-items:center}.nav button.active,.nav button:hover{background:#2b5d49;color:white}.nav button span{font-size:14px}.side-foot{margin-top:auto;padding:16px 9px 0;border-top:1px solid #3a6253;font-size:11px;color:#b9d7c9;overflow-wrap:anywhere}.side-foot button{display:block;background:none;color:#e5f1e9;margin-top:15px}.workspace{flex:1;min-width:0}header{display:flex;justify-content:space-between;align-items:center;padding:27px 38px;background:#fff;border-bottom:1px solid #edf0eb}.eyebrow{font-size:10px;letter-spacing:2.2px;color:#8aa093;font-weight:800}header h2{margin:6px 0 0;font-size:26px;letter-spacing:-.7px}.header-right{display:flex;gap:25px;align-items:center;font-size:12px;color:#778b80}.live{color:#21794f;background:#ecf8f0;padding:9px 12px;border-radius:30px}.live i{display:inline-block;background:#34b975;width:7px;height:7px;border-radius:50%;margin-right:5px}main{padding:30px 38px;max-width:1500px}.stats{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:17px}.stat,.panel{background:white;border-radius:16px;border:1px solid #e8eee7;box-shadow:0 3px 12px #253d2806}.stat{padding:21px}.stat .k{font-size:12px;color:#789085;font-weight:600}.stat .v{font-size:30px;letter-spacing:-1px;font-weight:800;margin:12px 0}.stat .detail{font-size:11px;color:#8da69a}.section-head{display:flex;align-items:center;justify-content:space-between;gap:12px;margin:28px 0 15px}.section-head h3{font-size:18px;margin:0}.muted{font-size:13px;color:#8a9c90}.panel{padding:22px;overflow:auto}.table{width:100%;border-collapse:collapse;min-width:540px;text-align:left}.table th{color:#90a398;font-size:11px;text-transform:uppercase;letter-spacing:.7px;font-weight:700}.table th,.table td{padding:13px 12px;border-bottom:1px solid #edf1ec;font-size:13px}.table tr:last-child td{border:0}.pill{padding:5px 9px;border-radius:20px;background:#e7f5ec;color:#237548;font-size:11px;font-weight:700}.pill.occupied,.pill.open{background:#fff1da;color:#a87017}.pill.cancelled{background:#f9e6e6;color:#b75353}.btn{border:1px solid #dce7dc;padding:9px 12px;border-radius:9px;background:white;color:#27553e;font-size:12px;font-weight:700}.btn:hover{background:#f3f8f4}.danger{color:#b44b49}.cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:15px}.table-card{background:white;border:1px solid #e4ece3;border-radius:15px;padding:20px;cursor:pointer}.table-card strong{font-size:19px}.table-card .sub{margin:12px 0;color:#82998a;font-size:12px}.table-card .footer{border-top:1px solid #e9eee7;padding-top:14px;font-size:12px}.table-card.occupied{border-color:#e4c78e;background:#fffdf7}.formrow{display:grid;grid-template-columns:repeat(3,minmax(100px,1fr));gap:12px;margin-bottom:18px}.formrow label{font-size:12px;color:#617a68;font-weight:700}.formrow input,.formrow select{width:100%;margin-top:7px}.order-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.line{display:flex;align-items:center;justify-content:space-between;gap:9px;border-bottom:1px solid #eff2ed;padding:12px 0;font-size:13px}.line select{width:60px;padding:7px;border:1px solid #dae4dc;border-radius:8px}.total{font-size:22px;font-weight:800;text-align:right;padding:17px 0}.empty{padding:35px;text-align:center;color:#91a299}#toast{position:fixed;right:22px;bottom:22px;background:#163d30;color:white;padding:14px 20px;border-radius:12px;display:none;box-shadow:0 8px 30px #172d2340;z-index:5}#toast.show{display:block}.action-bar{display:flex;gap:8px;flex-wrap:wrap}.right{text-align:right}@media(max-width:900px){.stats{grid-template-columns:repeat(2,1fr)}.order-grid{grid-template-columns:1fr}.sidebar{width:76px;padding:24px 10px}.brand strong,.brand small,.nav span,.side-foot span{display:none}.nav button{justify-content:center}.brand{padding-left:14px}.side-foot{padding:0}.side-foot button{font-size:9px;overflow-wrap:anywhere}}@media(max-width:600px){.sidebar{width:60px}.workspace header{padding:20px}.header-right{display:none}main{padding:18px}.stats{gap:8px}.stat{padding:14px}.stat .v{font-size:23px}.formrow{grid-template-columns:1fr}}
